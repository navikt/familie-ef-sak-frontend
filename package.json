{
    "name": "familie-ef-sak-frontend",
    "version": "0.0.1",
    "main": "dist/server/server.js",
    "repository": "https://github.com/navikt/familie-ef-sak-frontend.git",
    "author": "Nav - teamfamilie",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production node dist/server/server.js",
        "dev": "tsc -p tsconfig.backend.json && npm run tsc-alias && NODE_ENV=development node dist/server/server-lokal.js",
        "build": "npm run lint && npm run build:prod && npm run tsc-alias",
        "build:prod": "tsc -p tsconfig.backend.json && vite build",
        "lint": "tsc --noEmit && eslint './src/**/*.{js,ts,tsx}'",
        "lint:fix": "eslint './src/**/*.{js,ts,tsx}' --fix",
        "test": "vitest run --exclude '**/dist/**'",
        "tsc-alias": "tsc-alias -p tsconfig.backend.json"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,json}": ["prettier --write", "eslint --fix"]
    },
    "dependencies": {
        "@navikt/aksel-icons": "^8.15.0",
        "@navikt/ds-css": "^8.15.0",
        "@navikt/ds-react": "^8.15.0",
        "@navikt/ds-tokens": "^8.15.0",
        "@navikt/fnrvalidator": "^2.2.1",
        "@navikt/oasis": "^4.1.4",
        "@sentry/browser": "^10.68.0",
        "@sentry/core": "^10.68.0",
        "axios": "^1.18.1",
        "body-parser": "^2.3.0",
        "constate": "^4.0.0",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "express-static-gzip": "^3.0.1",
        "http-proxy-middleware": "^4.2.0",
        "node-fetch": "3.3.2",
        "prom-client": "^15.1.3",
        "quill": "^2.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-pdf": "10.4.1",
        "react-router-dom": "7.18.2",
        "styled-components": "^6.4.4",
        "uuid": "^14.0.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@axe-core/react": "4.12.1",
        "@eslint/js": "^9.39.4",
        "@types/express": "^5.0.6",
        "@types/express-session": "1.19.0",
        "@types/node": "^24.12.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/styled-components": "^5.1.36",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "6.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "postcss": "^8.5.24",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
